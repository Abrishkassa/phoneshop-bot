# Supabase transaction pooler connection string (Project Settings > Database > Connect)
# Note: driver prefix is postgresql+asyncpg (not the default postgresql://)
# If your password has special characters (@, :, /, #, etc), URL-encode them.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-telegram-user-id-here
SHOP_NAME=My Phone Shop
SHOP_PHONE=+251900000000
SHOP_LOCATION=Hawassa, Ethiopia